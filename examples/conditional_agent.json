{
  "version": "1.0",
  "metadata": {
    "name": "Conditional Branching Agent",
    "description": "Demonstrates conditional branching based on input value",
    "created": "2025-10-29T00:00:00Z",
    "framework_hints": ["pydantic_ai", "langgraph"],
    "tags": ["example", "conditional", "branching"]
  },
  "memory": {
    "inputs": {
      "score": {
        "type": "number",
        "description": "A numeric score",
        "required": true
      }
    },
    "outputs": {
      "result": {
        "type": "string",
        "description": "Result message"
      },
      "category": {
        "type": "string",
        "description": "Score category"
      }
    },
    "intermediate": {
      "is_high_score": {
        "type": "boolean",
        "description": "Whether score is high"
      },
      "high_message": {
        "type": "string",
        "description": "Message for high scores"
      },
      "low_message": {
        "type": "string",
        "description": "Message for low scores"
      }
    },
    "secrets": {}
  },
  "steps": [
    {
      "id": "start_1",
      "type": "start",
      "config": {},
      "memory_reads": [],
      "memory_writes": []
    },
    {
      "id": "conditional_1",
      "type": "conditional",
      "config": {
        "condition": "score >= 80",
        "result_key": "is_high_score"
      },
      "memory_reads": ["score"],
      "memory_writes": ["is_high_score"],
      "description": "Check if score is high (>= 80)"
    },
    {
      "id": "transform_high",
      "type": "transform",
      "config": {
        "operation": "high_score_message",
        "code": "return f'Excellent! Your score of {score} is outstanding!'",
        "input_keys": ["score"],
        "output_key": "high_message"
      },
      "memory_reads": ["score"],
      "memory_writes": ["high_message"],
      "description": "Generate high score message"
    },
    {
      "id": "transform_low",
      "type": "transform",
      "config": {
        "operation": "low_score_message",
        "code": "return f'Your score of {score} needs improvement.'",
        "input_keys": ["score"],
        "output_key": "low_message"
      },
      "memory_reads": ["score"],
      "memory_writes": ["low_message"],
      "description": "Generate low score message"
    },
    {
      "id": "join_1",
      "type": "join",
      "config": {
        "wait_for": ["transform_high", "transform_low"]
      },
      "memory_reads": [],
      "memory_writes": [],
      "description": "Wait for both branches to complete"
    },
    {
      "id": "transform_final",
      "type": "transform",
      "config": {
        "operation": "select_message",
        "code": "return high_message if is_high_score else low_message",
        "input_keys": ["is_high_score", "high_message", "low_message"],
        "output_key": "result"
      },
      "memory_reads": ["is_high_score", "high_message", "low_message"],
      "memory_writes": ["result"],
      "description": "Select appropriate message based on condition"
    },
    {
      "id": "output_1",
      "type": "output",
      "config": {
        "mapping": {
          "result": "result",
          "category": "is_high_score"
        }
      },
      "memory_reads": ["result", "is_high_score"],
      "memory_writes": ["result", "category"]
    }
  ],
  "edges": [
    {
      "id": "edge_1",
      "from": "start_1",
      "to": "conditional_1"
    },
    {
      "id": "edge_2_high",
      "from": "conditional_1",
      "to": "transform_high",
      "condition": "is_high_score == True"
    },
    {
      "id": "edge_2_low",
      "from": "conditional_1",
      "to": "transform_low",
      "condition": "is_high_score == False"
    },
    {
      "id": "edge_3_high",
      "from": "transform_high",
      "to": "join_1"
    },
    {
      "id": "edge_3_low",
      "from": "transform_low",
      "to": "join_1"
    },
    {
      "id": "edge_4",
      "from": "join_1",
      "to": "transform_final"
    },
    {
      "id": "edge_5",
      "from": "transform_final",
      "to": "output_1"
    }
  ]
}
