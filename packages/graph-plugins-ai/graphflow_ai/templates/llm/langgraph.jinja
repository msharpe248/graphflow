# LLM step using LangChain/LangGraph

{% if tool_imports %}
# Tool imports
{% for imp in tool_imports %}
{{ imp }}
{% endfor %}
{% endif %}

{% if mcp_tools %}
# MCP imports
from graphflow_ai.mcp_client import MCPServerPool, MCPServerConfig
{% endif %}

{% if history_enabled %}
# Session history imports
from graphflow_runtime.session import get_history, set_history
{% endif %}

{% if tool_code %}
# Tool factory function
{{ tool_code }}

{% endif %}
{% if mcp_tools %}
# MCP server initialization
_mcp_pool = MCPServerPool()
mcp_servers = {}
{% for server_key, config in mcp_server_configs.items() %}
_mcp_cfg_{{ loop.index }} = MCPServerConfig(
    transport="{{ config.transport }}",
{% if config.command %}    command="{{ config.command }}",
{% endif %}
{% if config.args %}    args={{ config.args | tojson }},
{% endif %}
{% if config.env %}    env={{ config.env | tojson }},
{% endif %}
{% if config.url %}    url="{{ config.url }}",
{% endif %}
{% if config.headers %}    headers={{ config.headers | tojson }},
{% endif %}
    timeout={{ config.timeout }},
)
mcp_servers["{{ server_key }}"] = await _mcp_pool.get_or_create(_mcp_cfg_{{ loop.index }})
{% endfor %}

{% endif %}
# Read LLM configuration from memory
_provider = self.memory.read("memory.{{ step.id }}.provider")
_model = self.memory.read("memory.{{ step.id }}.model")
_base_url = self.memory.read("memory.{{ step.id }}.base_url")
_system_prompt = self.memory.read("memory.{{ step.id }}.system_prompt")
_user_prompt = self.memory.read("memory.{{ step.id }}.user_prompt")
_temperature = self.memory.read("memory.{{ step.id }}.temperature") or {{ temperature }}

# Render prompts - replace any remaining memory references
{% for key in memory_refs | sort %}
{{ key | replace('.', '_') }} = self.memory.read("memory.{{ key }}")
{% endfor %}

# Build user prompt with variable substitution
user_prompt_template = str(_user_prompt) if _user_prompt else ""
{% for key in memory_refs | sort %}
user_prompt_template = user_prompt_template.replace("{memory.{{ key }}}", str({{ key | replace('.', '_') }}))
{% endfor %}

# Get API key
{% if api_key_secret %}
{% if api_key_secret.startswith('{memory.') %}
{% set api_key_mem_key = api_key_secret[8:-1] %}
api_key = self.memory.read("memory.{{ api_key_mem_key }}")
{% elif api_key_secret.startswith('{secrets.') %}
{% set api_key_secret_name = api_key_secret[9:-1] %}
api_key = self.memory.get_secret("{{ api_key_secret_name }}")
{% else %}
api_key = self.memory.get_secret("{{ api_key_secret }}")
{% endif %}
{% else %}
api_key = None  # Will use environment variable
{% endif %}

# Configure LLM based on provider (resolved at runtime)
if _provider == "openai":
    if _base_url:
        llm = ChatOpenAI(model=_model, temperature=_temperature, base_url=_base_url, api_key=api_key)
    else:
        llm = ChatOpenAI(model=_model, temperature=_temperature)
elif _provider == "anthropic":
    llm = ChatAnthropic(model=_model, temperature=_temperature)
elif _provider == "ollama":
    _ollama_url = _base_url or "http://localhost:11434"
    llm = ChatOllama(model=_model, temperature=_temperature, base_url=_ollama_url)
elif _provider == "groq":
    llm = ChatGroq(model=_model, temperature=_temperature)
elif _provider == "mistral":
    llm = ChatMistralAI(model=_model, temperature=_temperature)
elif _provider == "google":
    llm = ChatGoogleGenerativeAI(model=_model, temperature=_temperature)
elif _provider == "lmstudio":
    _lm_url = _base_url or "http://localhost:1234/v1"
    llm = ChatOpenAI(model=_model, temperature=_temperature, base_url=_lm_url, api_key="lm-studio")
elif _provider == "openrouter":
    llm = ChatOpenAI(model=_model, temperature=_temperature, base_url="https://openrouter.ai/api/v1", api_key=api_key)
elif _provider in ["azure", "openai_compatible"]:
    llm = ChatOpenAI(model=_model, temperature=_temperature, base_url=_base_url, api_key=api_key)
else:
    # Default: treat as OpenAI
    llm = ChatOpenAI(model=_model, temperature=_temperature)

{% if history_enabled %}
# Load conversation history from session
_session_id = self.memory.read("config.session_id") if self.memory.has_key("config.session_id") else None
_message_history = get_history(_session_id, "{{ step.id }}") if _session_id else []
{% endif %}

# Build messages
messages = []
{% if history_enabled %}
# Prepend history messages (if any)
messages.extend(_message_history)
{% endif %}
if _system_prompt:
    messages.append(SystemMessage(content=_system_prompt))
messages.append(HumanMessage(content=user_prompt_template))

{% if tool_names or mcp_tools %}
# Create tools with memory access (and MCP servers if applicable) and bind to LLM
tools = create_tools(self.memory{% if mcp_tools %}, mcp_servers{% endif %})
llm_with_tools = llm.bind_tools(tools)

# Invoke LLM with tools
response = await llm_with_tools.ainvoke(messages)

# Handle tool calls if present
if hasattr(response, 'tool_calls') and response.tool_calls:
    tool_results = []
    tool_map = {t.name: t for t in tools}

    for tool_call in response.tool_calls:
        tool_name = tool_call.get('name') or tool_call.get('function', {}).get('name')
        tool_args = tool_call.get('args') or tool_call.get('function', {}).get('arguments', {})

        # Log tool call to execution log
        self.memory.write("__tool_call__", {
            "event": "call",
            "tool_name": tool_name,
            "arguments": tool_args,
        })

        if tool_name in tool_map:
            tool_func = tool_map[tool_name]
            result = await tool_func.ainvoke(tool_args)
            tool_results.append({
                "tool": tool_name,
                "result": result
            })

            # Log tool result to execution log
            self.memory.write("__tool_call__", {
                "event": "result",
                "tool_name": tool_name,
                "result": result,
            })

    # Add tool results to conversation and get final response
    messages.append(response)
    for i, tool_call in enumerate(response.tool_calls):
        tool_name = tool_call.get('name') or tool_call.get('function', {}).get('name')
        from langchain_core.messages import ToolMessage
        messages.append(ToolMessage(
            content=str(tool_results[i]["result"]) if i < len(tool_results) else "",
            tool_call_id=tool_call.get('id', str(i))
        ))

    # Get final response after tool execution
    final_response = await llm_with_tools.ainvoke(messages)
    response_content = final_response.content
else:
    response_content = response.content
{% else %}
# Invoke LLM (no tools)
response = await llm.ainvoke(messages)
response_content = response.content
{% endif %}

{% if history_enabled %}
# Save updated conversation history
if _session_id:
    # Build history: current messages + assistant response
    _history_to_save = messages.copy()
    {% if tool_names or mcp_tools %}
    if hasattr(response, 'tool_calls') and response.tool_calls:
        _history_to_save.append(final_response)
    else:
        _history_to_save.append(response)
    {% else %}
    _history_to_save.append(response)
    {% endif %}
    set_history(_session_id, "{{ step.id }}", _history_to_save)
{% endif %}

# Write to memory using outputs dict
{% if output_schema and output_schema.properties %}
# Parse structured output
import json
try:
    response_data = json.loads(response_content)
except (json.JSONDecodeError, TypeError):
    response_data = {"answer": response_content, "confidence": 0.85}
{% for output_name, output_template in outputs.items() %}
{% if '{memory.' in output_template %}
{% set output_key = output_template.split('{memory.')[1].split('}')[0] %}
{% if output_name == 'response' %}
self.memory.write("memory.{{ output_key }}", response_data)
{% endif %}
{% endif %}
{% endfor %}
{% else %}
{% for output_name, output_template in outputs.items() %}
{% if '{memory.' in output_template %}
{% set output_key = output_template.split('{memory.')[1].split('}')[0] %}
{% if output_name == 'response' %}
self.memory.write("memory.{{ output_key }}", response_content)
{% elif output_name == 'tool_calls' %}
# Extract tool call history
tool_calls_data = []
{% if tool_names or mcp_tools %}
if hasattr(response, 'tool_calls') and response.tool_calls:
    for tc in response.tool_calls:
        tool_calls_data.append({
            "name": tc.get('name') or tc.get('function', {}).get('name'),
            "args": tc.get('args') or tc.get('function', {}).get('arguments', {}),
        })
{% endif %}
self.memory.write("memory.{{ output_key }}", tool_calls_data)
{% endif %}
{% endif %}
{% endfor %}
{% endif %}

{% if mcp_tools %}
# Cleanup MCP server connections
await _mcp_pool.close_all()
{% endif %}
