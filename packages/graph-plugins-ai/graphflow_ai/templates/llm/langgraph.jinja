# LLM step using LangChain
import os

# Render prompts from state
{%- for key in memory_refs | sort %}
{{ key | replace('.', '_') }} = state.get("{{ key }}", "")
{%- endfor %}

# Build prompt
{%- if user_prompt %}
user_prompt_template = {{ user_prompt | repr }}
{%- for key in memory_refs | sort %}
user_prompt_template = user_prompt_template.replace("{memory.{{ key }}}", str({{ key | replace('.', '_') }}))
{%- endfor %}
{%- else %}
user_prompt_template = ""
{%- endif %}

# Get API key
{%- if api_key_secret %}
api_key = os.getenv("{{ api_key_secret | upper }}", "")
{%- else %}
api_key = None
{%- endif %}

# Configure LLM based on provider
{%- if provider == "openai" %}
{%- if base_url %}
llm = ChatOpenAI(model="{{ model }}", temperature={{ temperature }}, base_url="{{ base_url }}", api_key=api_key)
{%- else %}
llm = ChatOpenAI(model="{{ model }}", temperature={{ temperature }})
{%- endif %}
{%- elif provider == "anthropic" %}
llm = ChatAnthropic(model="{{ model }}", temperature={{ temperature }})
{%- elif provider == "ollama" %}
llm = ChatOllama(model="{{ model }}", temperature={{ temperature }}, base_url="{{ base_url or 'http://localhost:11434' }}")
{%- elif provider == "groq" %}
llm = ChatGroq(model="{{ model }}", temperature={{ temperature }})
{%- elif provider == "mistral" %}
llm = ChatMistralAI(model="{{ model }}", temperature={{ temperature }})
{%- elif provider == "google" %}
llm = ChatGoogleGenerativeAI(model="{{ model }}", temperature={{ temperature }})
{%- elif provider == "lmstudio" %}
llm = ChatOpenAI(model="{{ model }}", temperature={{ temperature }}, base_url="{{ base_url or 'http://localhost:1234/v1' }}", api_key="lm-studio")
{%- elif provider == "openrouter" %}
llm = ChatOpenAI(model="{{ model }}", temperature={{ temperature }}, base_url="https://openrouter.ai/api/v1", api_key=api_key)
{%- elif provider in ["azure", "openai_compatible"] %}
llm = ChatOpenAI(model="{{ model }}", temperature={{ temperature }}, base_url="{{ base_url }}", api_key=api_key)
{%- else %}
# Default: treat as OpenAI
llm = ChatOpenAI(model="{{ model }}", temperature={{ temperature }})
{%- endif %}

# Build and send messages
messages = []
{%- if system_prompt %}
messages.append(SystemMessage(content={{ system_prompt | repr }}))
{%- endif %}
messages.append(HumanMessage(content=user_prompt_template))

# Invoke LLM
response = await llm.ainvoke(messages)

{%- if output_schema %}
# Parse structured output (placeholder)
# In production, use with_structured_output()
response_data = {"answer": response.content, "confidence": 0.85}
state["{{ output_key }}"] = response_data
{%- else %}
state["{{ output_key }}"] = response.content
{%- endif %}

return state
