# LLM step using Pydantic AI

{% if tool_imports %}
# Tool imports
{% for imp in tool_imports %}
{{ imp }}
{% endfor %}
{% endif %}

{% if mcp_tools %}
# MCP imports
from graphflow_ai.mcp_client import MCPServerPool, MCPServerConfig
{% endif %}

{% if history_enabled %}
# Session history imports
from graphflow_runtime.session import get_history, set_history
{% endif %}

{% if output_schema and output_schema.properties %}
# Define output schema
class LLMOutput_{{ step.id }}(BaseModel):
{% for prop_name, prop_def in output_schema.properties.items() %}
    {{ prop_name }}: {{ json_type_to_python(prop_def.type) }}  # {{ prop_def.description | default("") }}
{% endfor %}

{% endif %}
{% if tool_code %}
# Tool functions
{{ tool_code }}

{% endif %}
{% if mcp_tools %}
# MCP server initialization
_mcp_pool = MCPServerPool()
mcp_servers = {}
{% for server_key, config in mcp_server_configs.items() %}
_mcp_cfg_{{ loop.index }} = MCPServerConfig(
    transport="{{ config.transport }}",
{% if config.command %}    command="{{ config.command }}",
{% endif %}
{% if config.args %}    args={{ config.args | tojson }},
{% endif %}
{% if config.env %}    env={{ config.env | tojson }},
{% endif %}
{% if config.url %}    url="{{ config.url }}",
{% endif %}
{% if config.headers %}    headers={{ config.headers | tojson }},
{% endif %}
    timeout={{ config.timeout }},
)
mcp_servers["{{ server_key }}"] = await _mcp_pool.get_or_create(_mcp_cfg_{{ loop.index }})
{% endfor %}

{% endif %}
# LLM configuration (embedded at compile time)
_provider = {{ provider | repr }}
_model = {{ model | repr }}
_base_url = {{ base_url | repr if base_url else 'None' }}
_system_prompt = {{ system_prompt | repr if system_prompt else 'None' }}
_user_prompt = {{ user_prompt | repr if user_prompt else 'None' }}

# Render prompts - replace any remaining memory references
{% for key in memory_refs | sort %}
{{ key | replace('.', '_') }} = self.memory.read("memory.{{ key }}")
{% endfor %}

# Build user prompt with variable substitution
user_prompt_template = str(_user_prompt) if _user_prompt else ""
{% for key in memory_refs | sort %}
user_prompt_template = user_prompt_template.replace("{memory.{{ key }}}", str({{ key | replace('.', '_') }}))
{% endfor %}

# Get API key
{% if api_key_secret %}
{% if api_key_secret.startswith('{memory.') %}
{% set api_key_mem_key = api_key_secret[8:-1] %}
api_key = self.memory.read("memory.{{ api_key_mem_key }}")
{% elif api_key_secret.startswith('{secrets.') %}
{% set api_key_secret_name = api_key_secret[9:-1] %}
api_key = self.memory.get_secret("{{ api_key_secret_name }}")
{% else %}
api_key = self.memory.get_secret("{{ api_key_secret }}")
{% endif %}
{% else %}
api_key = None  # Will use environment variable
{% endif %}

# Configure model based on provider (resolved at runtime)
if _provider == "openai":
    from pydantic_ai.models.openai import OpenAIChatModel
    from pydantic_ai.providers.openai import OpenAIProvider
    if _base_url or api_key:
        _llm_provider = OpenAIProvider(base_url=_base_url, api_key=api_key)
        model_ref = OpenAIChatModel(_model, provider=_llm_provider)
    else:
        model_ref = f"openai:{_model}"
elif _provider == "anthropic":
    if api_key:
        from pydantic_ai.models.anthropic import AnthropicModel
        from pydantic_ai.providers.anthropic import AnthropicProvider
        _llm_provider = AnthropicProvider(api_key=api_key)
        model_ref = AnthropicModel(_model, provider=_llm_provider)
    else:
        model_ref = f"anthropic:{_model}"
elif _provider == "ollama":
    from pydantic_ai.models.openai import OpenAIChatModel
    from pydantic_ai.providers.ollama import OllamaProvider
    _ollama_url = _base_url or "http://localhost:11434"
    _llm_provider = OllamaProvider(base_url=f"{_ollama_url}/v1")
    model_ref = OpenAIChatModel(_model, provider=_llm_provider)
elif _provider == "groq":
    if api_key:
        from pydantic_ai.models.groq import GroqModel
        from pydantic_ai.providers.groq import GroqProvider
        _llm_provider = GroqProvider(api_key=api_key)
        model_ref = GroqModel(_model, provider=_llm_provider)
    else:
        model_ref = f"groq:{_model}"
elif _provider == "mistral":
    if api_key:
        from pydantic_ai.models.mistral import MistralModel
        from pydantic_ai.providers.mistral import MistralProvider
        _llm_provider = MistralProvider(api_key=api_key)
        model_ref = MistralModel(_model, provider=_llm_provider)
    else:
        model_ref = f"mistral:{_model}"
elif _provider == "google":
    if api_key:
        from pydantic_ai.models.google import GoogleModel
        from pydantic_ai.providers.google import GoogleProvider
        _llm_provider = GoogleProvider(api_key=api_key)
        model_ref = GoogleModel(_model, provider=_llm_provider)
    else:
        model_ref = f"google-gla:{_model}"
elif _provider == "lmstudio":
    from pydantic_ai.models.openai import OpenAIChatModel
    from pydantic_ai.providers.openai import OpenAIProvider
    _lm_url = _base_url or "http://localhost:1234/v1"
    _llm_provider = OpenAIProvider(base_url=_lm_url, api_key="lm-studio")
    model_ref = OpenAIChatModel(_model, provider=_llm_provider)
elif _provider == "openrouter":
    from pydantic_ai.models.openai import OpenAIChatModel
    from pydantic_ai.providers.openai import OpenAIProvider
    _llm_provider = OpenAIProvider(base_url="https://openrouter.ai/api/v1", api_key=api_key)
    model_ref = OpenAIChatModel(_model, provider=_llm_provider)
elif _provider in ["azure", "openai_compatible"]:
    from pydantic_ai.models.openai import OpenAIChatModel
    from pydantic_ai.providers.openai import OpenAIProvider
    _llm_provider = OpenAIProvider(base_url=_base_url, api_key=api_key)
    model_ref = OpenAIChatModel(_model, provider=_llm_provider)
else:
    # Default: treat as OpenAI
    model_ref = f"openai:{_model}"

# Create Pydantic AI agent
agent = Agent(
    model_ref,
    system_prompt=_system_prompt if _system_prompt else None,
{% if output_schema and output_schema.properties %}
    output_type=LLMOutput_{{ step.id }},
{% else %}
    output_type=str,
{% endif %}
{% if tool_names %}
    tools=[{{ tool_names | join(', ') }}],
{% endif %}
)

{% if history_enabled %}
# Load conversation history from session
_session_id = self.memory.read("config.session_id") if self.memory.has_key("config.session_id") else None
_message_history = get_history(_session_id, "{{ step.id }}") if _session_id else []
{% endif %}

# Run agent
{% if tool_names or mcp_tools %}
# Pass memory (and mcp_servers if applicable) in deps for tool access
result = await agent.run(user_prompt_template, deps={"memory": self.memory{% if mcp_tools %}, "mcp_servers": mcp_servers{% endif %}}{% if history_enabled %}, message_history=_message_history{% endif %})

# Log tool calls to execution log
if hasattr(result, 'all_messages'):
    for msg in result.all_messages():
        if hasattr(msg, 'parts'):
            for part in msg.parts:
                # Log tool call request (has tool_name and args)
                if hasattr(part, 'tool_name') and hasattr(part, 'args'):
                    self.memory.write("__tool_call__", {
                        "event": "call",
                        "tool_name": part.tool_name,
                        "arguments": part.args,
                    })
                # Log tool return (has tool_name and content - this is the result)
                if hasattr(part, 'tool_name') and hasattr(part, 'content') and not hasattr(part, 'args'):
                    self.memory.write("__tool_call__", {
                        "event": "result",
                        "tool_name": part.tool_name,
                        "result": part.content,
                    })
{% else %}
result = await agent.run(user_prompt_template{% if history_enabled %}, message_history=_message_history{% endif %})
{% endif %}

# Extract result
{% if output_schema and output_schema.properties %}
response_data = result.output.model_dump()
{% else %}
response_data = result.output
{% endif %}

{% if history_enabled %}
# Save updated conversation history
if _session_id:
    set_history(_session_id, "{{ step.id }}", result.all_messages())
{% endif %}

# Write to memory using outputs dict
{% for output_name, output_template in outputs.items() %}
{% if '{memory.' in output_template %}
{% set output_key = output_template.split('{memory.')[1].split('}')[0] %}
{% if output_name == 'response' %}
self.memory.write("memory.{{ output_key }}", response_data)
{% elif output_name == 'tool_calls' %}
# Extract tool call history from result
tool_calls_data = []
if hasattr(result, 'all_messages'):
    for msg in result.all_messages():
        if hasattr(msg, 'parts'):
            for part in msg.parts:
                if hasattr(part, 'tool_name'):
                    tool_calls_data.append({
                        "name": part.tool_name,
                        "args": getattr(part, 'args', {}),
                    })
self.memory.write("memory.{{ output_key }}", tool_calls_data)
{% endif %}
{% endif %}
{% endfor %}

{% if mcp_tools %}
# Cleanup MCP server connections
await _mcp_pool.close_all()
{% endif %}
