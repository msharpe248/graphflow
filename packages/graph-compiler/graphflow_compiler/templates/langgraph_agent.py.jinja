    def __init__(self, use_logging=True, execution_controller=None):
        """Initialize agent with LangGraph and optional debug controller."""
        if use_logging:
            from graphflow_runtime.executor.logging_memory import LoggingMemoryStore
            self.memory = LoggingMemoryStore(schema=MEMORY_SCHEMA)
        else:
            self.memory = MemoryStore(schema=MEMORY_SCHEMA)

        # Store execution controller for debug mode
        self.execution_controller = execution_controller

        self.graph = self._build_graph()
        self.app = self.graph.compile()

    def _build_graph(self) -> StateGraph:
        """Build the LangGraph StateGraph."""
        graph = StateGraph(AgentState)

        # Add nodes for each step
{% for step in steps %}
        graph.add_node("{{ step.id }}", self._node_{{ step.id }})
{% endfor %}

        # Add edges
{% for edge in graph_edges %}
{% if edge.condition %}
        # Conditional edge: {{ edge.condition }}
        graph.add_conditional_edges(
            "{{ edge.source }}",
            self._condition_{{ edge.source }}_{{ edge.target }},
            {
                True: "{{ edge.target }}",
                False: END
            }
        )
{% else %}
        graph.add_edge("{{ edge.source }}", "{{ edge.target }}")
{% endif %}
{% endfor %}

        # Set entry point
        graph.set_entry_point("{{ steps[0].id }}")

        # Set finish point (last step should lead to END)
        graph.add_edge("{{ steps[-1].id }}", END)

        return graph

