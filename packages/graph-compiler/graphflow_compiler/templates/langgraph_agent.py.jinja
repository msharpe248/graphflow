    async def run(self, inputs: Dict[str, Any]) -> Dict[str, Any]:
        """
        Run agent with given inputs.

        Args:
            inputs: Dictionary of input values

        Returns:
            Dictionary of output values
        """
        # Initialize memory with inputs
        self.memory.initialize_inputs(inputs)

        # Wait if paused before start (debug mode)
        if self.execution_controller:
            await self.execution_controller.wait_if_paused('__start__')

        # Initialize state with inputs
        state = AgentState(**inputs)

        # Run graph
        final_state = await self.app.ainvoke(state)

        # Extract outputs
        outputs = {}
{% for key, field in graph.memory.outputs.items() %}
        if "{{ key }}" in final_state:
            outputs["{{ key }}"] = final_state["{{ key }}"]
{% endfor %}

        return outputs

    def get_memory(self) -> MemoryStore:
        """Get memory store for inspection."""
        return self.memory

    def get_memory_state(self) -> Dict[str, Any]:
        """Get current memory state as dictionary."""
        return self.memory.to_dict()

    def get_execution_log(self) -> list:
        """Get execution log if using LoggingMemoryStore."""
        if hasattr(self.memory, 'get_log'):
            return self.memory.get_log()
        return []
