    def get_memory(self) -> MemoryStore:
        """Get memory store for inspection."""
        return self.memory

    def get_memory_state(self) -> Dict[str, Any]:
        """Get current memory state as dictionary."""
        return self.memory.to_dict()

    def get_execution_log(self) -> list:
        """Get execution log if using LoggingMemoryStore."""
        if hasattr(self.memory, 'get_log'):
            return self.memory.get_log()
        return []
