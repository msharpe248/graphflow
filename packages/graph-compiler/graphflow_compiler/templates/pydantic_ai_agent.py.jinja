    def __init__(self, use_logging=True, execution_controller=None):
        """Initialize agent with memory store and optional debug controller."""
        if use_logging:
            from graphflow_runtime.executor.logging_memory import LoggingMemoryStore
            self.memory = LoggingMemoryStore(schema=MEMORY_SCHEMA)
        else:
            self.memory = MemoryStore(schema=MEMORY_SCHEMA)

        # Store execution controller for debug mode
        self.execution_controller = execution_controller

    async def run(self, inputs: Dict[str, Any]) -> Dict[str, Any]:
        """
        Run agent with given inputs.

        Args:
            inputs: Dictionary of input values

        Returns:
            Dictionary of output values
        """
        # Initialize memory with inputs
        self.memory.initialize_inputs(inputs)

        # Populate config and environment namespaces
        # Note: Runtime config values are injected by the executor before run()
        # This allows runtime to inject cwd, runtime_url, and other system values

        # Environment variables from os.environ
{% if graph.memory.environment %}
