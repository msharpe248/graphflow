        self.memory.populate_environment(env_filter=env_filter)
{% endif %}

        # Wait if paused before start (debug mode)
        if self.execution_controller:
            await self.execution_controller.wait_if_paused('__start__')

        # Execute steps in order
{% for step_id in execution_order %}
{% set step = graph.steps | selectattr('id', 'equalto', step_id) | first %}
        # Wait if paused before step (debug mode)
        if self.execution_controller:
            await self.execution_controller.wait_if_paused("{{ step.id }}")

        # Set current step for logging
        if hasattr(self.memory, 'set_current_step'):
            self.memory.set_current_step("{{ step.id }}", "{{ step.label }}")

        # Execute step
        await self._execute_{{ step_id | pythonize }}()

        # Notify step completed (debug mode)
        if self.execution_controller:
            await self.execution_controller.step_completed("{{ step.id }}")
{% endfor %}

        # Return outputs
        return self.memory.get_all_outputs()

