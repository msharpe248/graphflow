{
  "version": "1.0",
  "metadata": {
    "name": "Simple Transform Agent",
    "description": "A simple agent that transforms text",
    "created": "2025-01-01T00:00:00Z",
    "framework_hints": ["pydantic_ai", "langgraph"],
    "tags": ["test", "simple"]
  },
  "memory": {
    "inputs": {
      "user_input": {
        "type": "string",
        "description": "User input text"
      }
    },
    "outputs": {
      "result": {
        "type": "string",
        "description": "Transformed result"
      }
    },
    "intermediate": {
      "uppercase_text": {
        "type": "string",
        "description": "Uppercased text"
      }
    }
  },
  "steps": [
    {
      "id": "transform_1",
      "type": "transform",
      "config": {
        "input": "{memory.user_input}",
        "transform_type": "uppercase"
      },
      "outputs": {
        "result": "{memory.uppercase_text}"
      }
    },
    {
      "id": "transform_2",
      "type": "transform",
      "config": {
        "input": "{memory.uppercase_text}",
        "transform_type": "add_prefix",
        "prefix": "RESULT: "
      },
      "outputs": {
        "result": "{memory.result}"
      }
    }
  ],
  "edges": [
    {
      "id": "edge_1",
      "from": "transform_1",
      "to": "transform_2"
    }
  ]
}
