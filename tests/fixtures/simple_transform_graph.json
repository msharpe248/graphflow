{
  "version": "1.0",
  "metadata": {
    "name": "Simple Transform Agent",
    "description": "A simple agent that transforms text",
    "created": "2025-01-01T00:00:00Z",
    "framework_hints": ["pydantic_ai", "langgraph"],
    "tags": ["test", "simple"]
  },
  "memory": {
    "inputs": {
      "user_input": {
        "type": "string",
        "description": "User input text"
      }
    },
    "outputs": {
      "result": {
        "type": "string",
        "description": "Transformed result"
      }
    },
    "intermediate": {
      "uppercase_text": {
        "type": "string",
        "description": "Uppercased text"
      }
    }
  },
  "steps": [
    {
      "id": "transform_1",
      "type": "transform",
      "config": {
        "operation": "uppercase",
        "code": "return user_input.upper()",
        "input_keys": ["user_input"],
        "output_key": "uppercase_text"
      },
      "outputs": {
        "result": "{memory.uppercase_text}"
      }
    },
    {
      "id": "transform_2",
      "type": "transform",
      "config": {
        "operation": "add_prefix",
        "code": "return 'RESULT: ' + uppercase_text",
        "input_keys": ["uppercase_text"],
        "output_key": "result"
      },
      "outputs": {
        "result": "{memory.result}"
      }
    }
  ],
  "edges": [
    {
      "id": "edge_1",
      "from": "transform_1",
      "to": "transform_2"
    }
  ]
}
